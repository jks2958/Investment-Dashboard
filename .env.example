# Neon Postgres connection string
DATABASE_URL=

# Single-user passphrase gate
AUTH_PASSPHRASE=
AUTH_SESSION_SECRET=

# Finnhub (stocks/ETFs) — https://finnhub.io
FINNHUB_API_KEY=

# Optional. Enables the nightly net-worth snapshot cron so history has no gaps
# on days you don't open the app. Vercel sends this as a bearer token on cron
# invocations; without it the cron path is refused rather than left open.
CRON_SECRET=

# Optional. Your offset from UTC in minutes, so a snapshot is filed under the
# day you're actually in. Functions run in UTC; Pakistan (UTC+5) is 300.
SNAPSHOT_UTC_OFFSET_MINUTES=
