{
  "buildCommand": "npm run db:migrate && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/holdings/:id", "destination": "/api/holdings?id=:id" },
    { "source": "/api/cash/:id", "destination": "/api/cash?id=:id" },
    { "source": "/api/other-assets/:id", "destination": "/api/other-assets?id=:id" },
    { "source": "/api/wishlist/:id", "destination": "/api/wishlist?id=:id" },
    { "source": "/api/transactions/:id", "destination": "/api/transactions?id=:id" },
    {
      "source": "/api/recurring/:id",
      "destination": "/api/transactions?kind=recurring&id=:id"
    },
    { "source": "/api/recurring", "destination": "/api/transactions?kind=recurring" },
    { "source": "/api/auth/:action", "destination": "/api/auth?action=:action" },
    { "source": "/api/debts/:id", "destination": "/api/liabilities?kind=debt&id=:id" },
    { "source": "/api/debts", "destination": "/api/liabilities?kind=debt" },
    {
      "source": "/api/commitments/:id",
      "destination": "/api/liabilities?kind=commitment&id=:id"
    },
    { "source": "/api/commitments", "destination": "/api/liabilities?kind=commitment" },
    { "source": "/api/snapshots/:date", "destination": "/api/snapshots?date=:date" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/snapshots", "schedule": "0 18 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "crons": [{ "path": "/api/snapshots", "schedule": "0 18 * * *" }],
  "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
